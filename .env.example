# ==========================================
# KONFIGURASI SERVER & PORT (Node.js & Go)
# ==========================================

# SERVER_HOST / HOST: Host tempat Node.js server berjalan (Default: 0.0.0.0)
SERVER_HOST="0.0.0.0"
HOST="0.0.0.0"

# SERVER_PORT / PORT: Port utama server Node.js / Express (Default: 3000)
SERVER_PORT=3000
PORT=3000

# GO_PORT: Port internal untuk server GoFiber backend (Default: 8081)
GO_PORT=8081

# GO_BACKEND_TARGET: Target URL proxy Node.js ke backend Go (Default: http://127.0.0.1:8081)
GO_BACKEND_TARGET="http://127.0.0.1:8081"

# SKIP_GO_SPAWN: Set 'true' jika backend Go sudah dijalankan di container terpisah (Default: false)
SKIP_GO_SPAWN="false"

# APP_URL: URL publik aplikasi
APP_URL="http://localhost:3000"


# ==========================================
# KONFIGURASI DATABASE (PostgreSQL / SQLite)
# ==========================================

# DB_DRIVER: Driver database ('postgres' atau kosong/sqlite)
DB_DRIVER="postgres"

# POSTGRES_HOST: Host database PostgreSQL (misal 'database' pada Docker Compose)
POSTGRES_HOST="database"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="fiber_gopher_rag"
POSTGRES_SSLMODE="disable"

# DATABASE_URL: Alternative Connection String DSN jika menggunakan cloud Postgres
DATABASE_URL=""


# ==========================================
# KONFIGURASI AI / RAG PROVIDERS
# ==========================================

# GEMINI_API_KEY: Kunci API Google Gemini untuk sintesis teks AI & RAG (opsional)
GEMINI_API_KEY=""

# DEEPSEEK_API_KEY: Kunci API DeepSeek sebagai alternatif provider LLM/RAG (opsional)
DEEPSEEK_API_KEY=""
